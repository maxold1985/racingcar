-- RacingCar city: deterministic grid, real asset footprint, bounded chunk streaming.
-- city_asset_metrics.luau is generated by tools/convert_city_fbx.py.
local CHUNK_SIZE = 192
local CELL = 16
local VIEW_RADIUS = 1
local SEED = 24681357
local active = {}
local nextId = 1
local lastX, lastZ = nil, nil
local metrics = CityAssets or {}
local warned = false

local function hash(x, z, salt)
    local n = (x * 73856093 + z * 19349663 + salt * 83492791 + SEED) % 2147483647
    return (n * 48271 + 1) % 2147483647
end

local function fit(model, maxWidth, maxDepth)
    local m = metrics[model]
    if m == nil or m.width <= 0 or m.depth <= 0 then return nil end
    return math.min(maxWidth / m.width, maxDepth / m.depth)
end

local function place(id, model, x, z, angle, width, depth)
    local scale = fit(model, width, depth)
    if scale then CityWorld.add(id, model, x, 0, z, angle, scale) end
end

local function spawnChunk(cx, cz)
    local key = tostring(cx) .. ":" .. tostring(cz)
    if active[key] then return end
    local id = nextId
    nextId += 1
    active[key] = id
    local ox, oz = cx * CHUNK_SIZE, cz * CHUNK_SIZE
    -- Road tiles occupy reserved 16x16 cells; intersections never overlap buildings.
    for ix = 0, 11 do
        for iz = 0, 11 do
            local x = ox + (ix + 0.5) * CELL
            local z = oz + (iz + 0.5) * CELL
            local roadX = ix == 0 or ix == 6
            local roadZ = iz == 0 or iz == 6
            if roadX and roadZ then
                place(id, 2, x, z, 0, 15.8, 15.8)
            elseif roadX then
                place(id, 1, x, z, 0, 15.8, 15.8)
            elseif roadZ then
                place(id, 1, x, z, 90, 15.8, 15.8)
            end
        end
    end
    -- Buildings use independent 32x32 lots, never a road cell.
    -- A 2-cell setback avoids the road and leaves a gap between buildings.
    for ix = 2, 10, 2 do
        for iz = 2, 10, 2 do
            if ix ~= 6 and iz ~= 6 and ix ~= 5 and iz ~= 5 then
                local x = ox + (ix + 0.5) * CELL
                local z = oz + (iz + 0.5) * CELL
                if math.abs(x) > 56 or math.abs(z) > 56 then
                    local n = hash(cx * 12 + ix, cz * 12 + iz, 1)
                    if n % 3 ~= 0 then
                        local model = 4 + n % 3
                        place(id, model, x, z, (n % 4) * 90, 23, 23)
                    end
                end
            end
        end
    end
end

function cityUpdate(x, z)
    if not warned then
        warned = true
        if not metrics[1] then
            print("[CITY] Missing model dimensions. Run FBX converter again.")
        end
    end
    local cx = math.floor(x / CHUNK_SIZE)
    local cz = math.floor(z / CHUNK_SIZE)
    if cx == lastX and cz == lastZ then return end
    lastX, lastZ = cx, cz
    -- Unload before loading to cap peak instance count.
    for key, id in active do
        local sx, sz = string.match(key, "^(-?%d+):(-?%d+)$")
        local bx, bz = tonumber(sx), tonumber(sz)
        if math.abs(bx - cx) > VIEW_RADIUS or math.abs(bz - cz) > VIEW_RADIUS then
            CityWorld.remove(id)
            active[key] = nil
        end
    end
    for dx = -VIEW_RADIUS, VIEW_RADIUS do
        for dz = -VIEW_RADIUS, VIEW_RADIUS do
            spawnChunk(cx + dx, cz + dz)
        end
    end
end
